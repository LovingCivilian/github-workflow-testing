# Normalise line endings: LF in the repo, native on checkout is avoided by forcing LF.
* text=auto eol=lf

# Windows-only files keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaries: never diff or normalise
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary

# Collapse generated and lock files in GitHub diffs
package-lock.json linguist-generated=true
yarn.lock linguist-generated=true
pnpm-lock.yaml linguist-generated=true
poetry.lock linguist-generated=true
uv.lock linguist-generated=true
Cargo.lock linguist-generated=true
go.sum linguist-generated=true

# Append-only files merge without conflicts
CHANGELOG.md merge=union
